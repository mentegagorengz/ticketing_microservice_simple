# Copy to .env and adjust. docker-compose and the Nest apps both read this file.
# NOTE: DB_USER/DB_PASSWORD/DB_NAME only take effect on FIRST postgres start.
# Changing them later needs: docker compose down -v (wipes data).

# Postgres — DB_PORT is the host port, container is always 5432
DB_HOST=localhost
DB_PORT=5435
DB_USER=max_admin
DB_PASSWORD=change_me
DB_NAME=ticket_db

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# RabbitMQ — creds for the container, URL for the apps (keep them in sync)
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# Engine HTTP port
PORT=3000
